# ---- Go（参考 github.com/github/gitignore 的 Go 模板）----
# 编译产物（本项目二进制为根目录的 fc-proxy）
/fc-proxy
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试二进制与覆盖率输出
*.test
*.out

# Go workspace 文件
go.work
go.work.sum

# ---- 本地配置（含真实 token，严禁提交；保留示例模板）----
/proxy.yaml
/configs/*.yaml
!/configs/config.example.yaml

# ---- macOS ----
.DS_Store

# ---- IDE ----
.idea/
.vscode/

# ---- AI 工具本地配置与生成文档 ----
.qoder/
.qoder-cn/
.claude/
.codex/
.agents/
